{
  "BaseUrl": "",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Database": {
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false
  },
  "FileUpload": {
    "MaxDocumentSize": 10485760,
    "AllowedImageExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".bmp" ],
    "AllowedDocumentExtensions": [ ".pdf", ".doc", ".docx", ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".tiff" ]
  },
  "FFmpeg": {
    "Directory": "ffmpeg",
    "DefaultFrameCaptureTimeoutSeconds": 15,
    "MaxCapturedFrameBytes": 10485760,
    "CapabilityCacheSeconds": 300,
    "ProcessStopTimeoutMs": 2000
  },
  "CompreFace": {
    "Enabled": false,
    "BaseUrl": "",
    "DefaultMarginPercent": 40,
    "MinimumConfidence": 0.8,
    "MinimumSimilarity": 0.85,
    "MaxFacesDetect": 1,
    "TimeoutSeconds": 2,
    "MaxRetries": 0,
    "CircuitBreakerFailureThreshold": 1,
    "CircuitBreakerRecoverySeconds": 60
  },
  "LuxandFaceSDK": {
    "Enabled": false,
    "MatchThreshold": 0.0,
    "DetectionThreshold": 3,
    "InternalResizeWidth": 960,
    "CropMarginPercent": 20,
    "MaxAdditionalTemplatesPerIdentity": 5,
    "ArbitraryRotationsEnabled": true,
    "DetermineRotationAngle": true,
    "DebugFrameDumpEnabled": false,
    "DebugFrameDumpPath": ""
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "Username": "",
    "FromEmail": "",
    "FromName": "Visitor Management System",
    "EnableSsl": true,
    "EnableSending": false
  },
  "LdapConfiguration": {
    "Enabled": false,
    "Server": "",
    "Port": 389,
    "Domain": "",
    "UserName": "",
    "BaseDn": "",
    "AutoCreateUsers": false,
    "SyncProfileOnLogin": false,
    "FollowReferrals": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\ProgramData\\VMS\\logs\\app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {CorrelationId} {ThreadId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithCorrelationId", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
