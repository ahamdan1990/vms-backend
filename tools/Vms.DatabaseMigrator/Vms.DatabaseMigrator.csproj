<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- .NET 9 marks apphosts CET/shadow-stack compatible by default. On Windows 10
         with CET-capable CPUs the CLR fail-fasts at startup
         (assert !AreShadowStacksEnabled() || UseSpecialUserModeApc(), 0xC0000602)
         because special user-mode APCs require Windows 11. Opt out until all
         target machines run Windows 11+. -->
    <CetCompat>false</CetCompat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\VisitorManagementSystem.Api.csproj" />
  </ItemGroup>
</Project>
