{
  "SchemaVersion": 1,
  "BaseUrl": "",
  "ConnectionStrings": {
    "Redis": "127.0.0.1:6379"
  },
  "Security": {
    "EnforceCanonicalHost": false,
    "PasswordPolicy": {
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true,
      "RequiredLength": 12,
      "RequiredUniqueChars": 4
    },
    "Lockout": {
      "DefaultLockoutTimeSpan": "00:05:00",
      "MaxFailedAccessAttempts": 10
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "EnableSsl": true,
    "Username": "",
    "FromEmail": "",
    "FromName": "Visitor Management System",
    "EnableSending": false
  },
  "SystemSettings": {
    "DefaultTimeZone": "UTC",
    "DateFormat": "yyyy-MM-dd",
    "TimeFormat": "HH:mm:ss",
    "DefaultPageSize": 20,
    "MaxPageSize": 50,
    "SessionTimeout": "00:30:00",
    "EnableAuditLogging": true,
    "EnableRealTimeNotifications": true
  }
}
